/target/
/tmp/
**/__pycache__/
*.py[cod]

# Local benchmark tool state and build output.
/benchmarks/neo4j/.gradle/
/benchmarks/neo4j/build/

# Editor and macOS metadata.
.DS_Store
.idea/
.vscode/
*.swp

# Maintainer-only brand notes are not part of the public source tree.
/.agents/

# Local fuzzing corpus and crash artifacts. Seed cases live under
# fuzz/corpus-seed and remain versioned.
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/target/

# Local compatibility crates are libraries; their standalone lock files are
# generated only when checking those manifests directly.
/third-party/*/Cargo.lock
/third-party/*/target/
